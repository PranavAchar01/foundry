# FOUNDRY — copy to .env.local and fill. Never commit the filled copy.
# Anything left empty falls back to a no-key implementation; nothing here blocks
# a cold start except ANTHROPIC_API_KEY, POSTGRES_URL and the Stripe pair.

# ---------- CORE BRAIN (required) ----------
ANTHROPIC_API_KEY=
FOUNDRY_MODEL=claude-opus-5

# ---------- MONEY (required) ----------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_COUNTRY=US
STRIPE_ACCOUNT_ID=
# Always explicit. Automatic payment methods resolve to none on an unactivated
# account and the API returns 400.
STRIPE_PAYMENT_METHOD_TYPES=card

# ---------- DEPLOY TARGET ----------
VERCEL_PROJECT_ID=
VERCEL_PROJECT_NAME=
FOUNDRY_PUBLIC_URL=
GITHUB_REPO=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_PREFIX=foundry-biz

# ---------- HUMAN LABOR AS COGS ----------
# Empty key => LABOR_PROVIDER falls back to the seeded stub. Nothing blocks.
TERAC_API_KEY=
TERAC_API_BASE=https://terac.com/api/external/v2
TERAC_ESCALATION_THRESHOLD=0.65
TERAC_MAX_SPEND_USD=40
# Explicit override: terac | stub. Unset means "terac if the key is set".
LABOR_PROVIDER=

# ---------- DATABASE ----------
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# ---------- HARD GUARDRAILS ----------
FOUNDRY_TOTAL_BUDGET_USD=150
FOUNDRY_PER_BUSINESS_BUDGET_USD=25
FOUNDRY_KILL_THRESHOLD_VISITORS=40
FOUNDRY_KILL_THRESHOLD_CONVERSIONS=0
FOUNDRY_MAX_BUSINESSES=8
FOUNDRY_CIRCUIT_BREAKER=on
FOUNDRY_COLD_START_AT=

# ---------- SPONSOR CAPABILITY FLAGS ----------
FOUNDRY_PAGEGEN_PROVIDER=internal      # internal | lovable
FOUNDRY_CHECKOUT_PROVIDER=stripe       # stripe | whop | dodo
FOUNDRY_SANDBOX_PROVIDER=vercel        # vercel | sandbox0 | superserve
FOUNDRY_BUS_PROVIDER=postgres          # postgres | band
FOUNDRY_SUPPORT_PROVIDER=resend        # resend | linq
FOUNDRY_QA_PROVIDER=playwright         # playwright | replay
FOUNDRY_HOST_PROVIDER=vercel           # vercel | render

LOVABLE_API_KEY=
RENDER_API_KEY=
WHOP_API_KEY=
WHOP_COMPANY_ID=
DODO_PAYMENTS_API_KEY=
SANDBOX0_API_KEY=
SUPERSERVE_API_KEY=
BAND_API_KEY=
LINQ_API_KEY=
LINQ_PHONE_NUMBER=
REPLAY_API_KEY=

# ---------- OUTBOUND ----------
RESEND_API_KEY=
FOUNDRY_DISCLOSURE_LINE=This business is operated end-to-end by an AI agent. No human wrote this.

# ---------- CRON ----------
# Generated by scripts/push-env-vercel.mjs. Guards /api/cron/ceo against
# anonymous invocation; Vercel's own scheduler is recognised by its header.
CRON_SECRET=

# Binds the deployment X account to one browser session, so the owner keeps
# their connection when the site became multi-tenant. Generate 24 random bytes.
FOUNDRY_OWNER_KEY=
